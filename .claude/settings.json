{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-agent-docs.sh",
            "timeout": 10,
            "statusMessage": "Checking rule zero"
          }
        ]
      }
    ]
  }
}
